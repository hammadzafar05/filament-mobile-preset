# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Check everything out with LF, on every platform. Without this, a Windows clone gets CRLF
# working copies and Pint reports line_ending violations on files that are LF in the object
# store and pass cleanly in CI — false failures that only the Windows maintainer sees.
* text=auto eol=lf

# Keep the distributed archive to what consumers actually load: src, resources, composer.json
# and the docs. Everything below is development-only.
/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.editorconfig          export-ignore
/.idea                  export-ignore
/.vscode                export-ignore
/art                    export-ignore
/composer.lock          export-ignore
/phpstan-baseline.neon  export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml.dist       export-ignore
/pint.json              export-ignore
/rector.php             export-ignore
/testbench.yaml         export-ignore
/tests                  export-ignore
